<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="background">#F4F7F5</color>
    <color name="card_border">#E1E9E3</color>
    <color name="error">#B72C35</color>
    <color name="error_light">#FFF0F0</color>
    <color name="green">#0C8B65</color>
    <color name="green_dark">#08734F</color>
    <color name="green_light">#E8F5EE</color>
    <color name="ink">#18242E</color>
    <color name="muted">#596B62</color>
    <color name="warning">#946D00</color>
    <color name="warning_light">#FFF5DA</color>
    <style name="Text.Body" parent="">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Text.Error" parent="">
        <item name="android:background">@drawable/bg_error</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/error</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="Text.Eyebrow" parent="">
        <item name="android:textColor">@color/green</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="Text.Pill" parent="">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/green_dark</item>
    </style>
    <style name="Text.Title" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Theme.Covoitall" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorPrimaryVariant">@color/green_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/green</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialButtonStyle">@style/Widget.Covoitall.Button</item>
    </style>
    <style name="Widget.Covoitall.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.Covoitall.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Covoitall.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Covoitall.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">#FFFFFF</item>
    </style>
    <style name="Widget.Covoitall.Input" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeColor">@color/green</item>
        <item name="hintTextColor">@color/green</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
</resources>